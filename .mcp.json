{
  "mcpServers": {
    "chrome-devtools": {
      "command": "chrome-devtools-mcp",
      "args": [
        "--headless",
        "--executablePath", "/usr/local/bin/chrome-headless",
        "--categoryPerformance=false",
        "--categoryEmulation=false",
        "--screenshotFormat", "jpeg"
      ]
    }
  }
}
